# Copy to .env.local and adjust. Vite only exposes variables prefixed with VITE_.

# Base URL the app sends requests to. Keep "/api" in development so the Vite proxy is used.
VITE_API_BASE_URL=/api

# Where the dev server forwards /api requests (the FastAPI backend).
VITE_API_PROXY_TARGET=http://127.0.0.1:8000

# Request timeout in milliseconds.
VITE_API_TIMEOUT_MS=15000

# Where the notebook downloads Python (Pyodide) from. Leave unset to use the default
# jsDelivr CDN for the Pyodide version pinned in src/services/python/pythonKernel.js.
# To self-host, copy a Pyodide "full" distribution and point this at it (keep the trailing /).
# VITE_PYODIDE_INDEX_URL=https://cdn.jsdelivr.net/pyodide/v314.0.7/full/
