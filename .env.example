# Copy to .env.local and adjust. Vite only exposes variables prefixed with VITE_.

# API path on the backend. An absolute URL here is used as is.
VITE_API_BASE_URL=/api

# The backend the browser calls directly (requests go to <target>/api/...).
# Its CORS settings must allow this site's origin (Render allows http://localhost:5173).
# Leave empty to keep requests relative and let the Vite dev proxy forward them to 127.0.0.1:8000.
VITE_API_PROXY_TARGET=https://taskgeneration.onrender.com

# Request timeout in milliseconds.
VITE_API_TIMEOUT_MS=15000

# Where the notebook downloads Python (Pyodide) from. Leave unset to use the default
# jsDelivr CDN for the Pyodide version pinned in src/services/python/pythonKernel.js.
# To self-host, copy a Pyodide "full" distribution and point this at it (keep the trailing /).
# VITE_PYODIDE_INDEX_URL=https://cdn.jsdelivr.net/pyodide/v314.0.7/full/
